{
  "name": "Atomic FE Starterkit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bullseye",

  // Install dependencies automatically after the container is created
  "postCreateCommand": "yarn install",

  // Forward Vite's default port so the browser can reach it
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
